---
/* Full menu: a swipe-to-close bottom sheet on phones, a side drawer on desktop. */
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { MENU } from "../data/site";
---

<div id="sheet" class="sheet fixed inset-0 z-200" hidden>
  <div class="sheet-backdrop absolute inset-0 bg-black/50" data-close></div>
  <aside
    id="sheetPanel"
    class="sheet-panel absolute inset-x-0 bottom-0 flex h-[calc(100dvh-max(env(safe-area-inset-top),20px)-12px)] flex-col rounded-t-[28px] bg-white text-ink-2 shadow-[0_-20px_60px_-20px_rgb(0_0_0/.4)] lg:inset-y-0 lg:right-0 lg:left-auto lg:h-auto lg:w-[min(620px,100%)] lg:rounded-none"
    role="dialog"
    aria-modal="true"
    aria-labelledby="sheetTitle"
  >
    <header id="sheetHead" class="touch-none px-5 pt-2.5 lg:touch-auto lg:px-6.5 lg:pt-6.5">
      <span class="mx-auto mb-3 block h-1.25 w-11 rounded-full bg-ink/15 lg:hidden" aria-hidden="true"></span>
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="kicker mb-1.5"><Icon name="book-open" size={15} /> Full menu</p>
          <h2 id="sheetTitle" class="font-display text-[clamp(1.5rem,6vw,2.1rem)] leading-[1.05] font-semibold tracking-[-.03em]">What are you <em class="serif text-brown">craving?</em></h2>
        </div>
        <button class="icon-btn size-10 lg:size-11" data-close aria-label="Close menu"><Icon name="x" /></button>
      </div>
    </header>

    <div id="sheetTabs" class="no-scrollbar mt-3 flex gap-2 overflow-x-auto border-b border-line px-5 pt-1 pb-3.5 lg:px-6.5 lg:pb-4" role="tablist" aria-label="Menu categories">
      {MENU.map((c) => (
        <button class="tab inline-flex min-h-10 shrink-0 items-center gap-1.75 rounded-full border border-line bg-white px-3.5 text-[.84rem] font-semibold text-muted transition-colors hover:text-ink aria-selected:border-ink aria-selected:bg-ink aria-selected:text-white" role="tab" id={`tab-${c.id}`} data-id={c.id} aria-selected="false" aria-controls={`panel-${c.id}`} tabindex="-1">
          <Icon name={c.icon} size={15} />{c.label}
        </button>
      ))}
    </div>

    <div id="sheetBody" class="flex-1 overflow-y-auto overscroll-contain px-5 pt-5 pb-8 lg:px-6.5 lg:pt-5.5" data-lenis-prevent>
      {MENU.map((c) => (
        <div id={`panel-${c.id}`} role="tabpanel" aria-labelledby={`tab-${c.id}`} data-panel={c.id} hidden>
          {c.photo && (
            <figure class="mb-6 aspect-[16/8] overflow-hidden rounded-2xl bg-sand lg:aspect-[16/7]">
              <Image src={c.photo} alt="" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 570px, 100vw" class="size-full object-cover" />
            </figure>
          )}
          {c.groups.map((g) => (
            <section class="mgroup mb-7">
              <div class="mb-1 flex items-end justify-between gap-3">
                <h3 class="font-display text-[1.25rem] font-semibold tracking-[-.02em] lg:text-[1.3rem]">{g.title}</h3>
                {g.cols && (
                  <div class="hidden gap-3 text-[.66rem] font-bold tracking-[.08em] text-muted-2 uppercase sm:flex">
                    {g.cols.map((col) => <span class="min-w-21 text-right">{col.label === "Size" ? col.size : `${col.label} ${col.size}`}</span>)}
                  </div>
                )}
              </div>
              {g.note && <p class="mb-1 text-[.82rem] font-semibold text-brown">{g.note}</p>}
              {g.cols && <p class="mb-1 text-[.76rem] font-semibold text-muted-2 sm:hidden">{g.cols.map((col) => `${col.label === "Size" ? "" : col.label + " "}${col.size}`).join(" · ")}</p>}
              <ul>
                {g.items.map((it) => (
                  <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1.5 border-b border-dashed border-ink/14 py-3 last:border-b-0 sm:flex-nowrap">
                    <div class="min-w-0 flex-1">
                      <span class="font-semibold">{it.name}</span>
                      {it.badge && <span class="ml-2 rounded-full bg-ink px-1.75 py-0.75 align-[2px] text-[.58rem] font-bold tracking-[.1em] text-white uppercase">{it.badge}</span>}
                      {it.desc && <span class="mt-0.5 block text-[.82rem] leading-snug text-muted">{it.desc}</span>}
                    </div>
                    {it.prices && (
                      <div class:list={["flex gap-2 font-bold whitespace-nowrap tabular-nums sm:gap-3", g.cols && g.cols.length > 1 && "w-full sm:w-auto"]}>
                        {it.prices.map((p, i) => (
                          <span class:list={["sm:min-w-21 sm:text-right", g.cols && g.cols.length > 1 && "rounded-lg bg-paper px-2.5 py-1 text-[.88rem] sm:bg-transparent sm:p-0 sm:text-base"]}>
                            {g.cols && g.cols.length > 1 && <small class="mr-1.5 font-semibold text-muted-2 sm:hidden">{g.cols[i].label}</small>}
                            <small class="font-medium text-muted-2">₱</small>{p}
                          </span>
                        ))}
                      </div>
                    )}
                  </li>
                ))}
              </ul>
              {g.chips?.map((chip) => (
                <>
                  <p class="mt-5 mb-1 text-[.82rem] font-semibold text-brown">{chip.title}</p>
                  <div class="mt-2 flex flex-wrap gap-2">{chip.list.map((x) => <span class="rounded-full bg-paper px-3.25 py-1.5 text-[.84rem] font-medium">{x}</span>)}</div>
                </>
              ))}
            </section>
          ))}
        </div>
      ))}
    </div>
    <footer class="border-t border-line px-5 pt-3 pb-[calc(12px+env(safe-area-inset-bottom))] text-[.78rem] text-muted-2 lg:px-6.5">Prices in PHP · exclusive of 5% service charge</footer>
  </aside>
</div>
