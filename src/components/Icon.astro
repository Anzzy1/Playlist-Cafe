---
/* Lucide icon by kebab-case name, plus the brand marks Lucide no longer ships. */
import { icons } from "@lucide/astro";

interface Props {
  name: string;
  class?: string;
  size?: number;
}

const { name, class: className = "", size = 18 } = Astro.props;
const cls = `shrink-0 ${className}`;
const pascal = name.replace(/(^|-)(\w)/g, (_, __, c: string) => c.toUpperCase()) as keyof typeof icons;
const Lucide = icons[pascal];
if (!Lucide && name !== "facebook" && name !== "instagram") throw new Error(`Unknown icon: ${name}`);
---

{name === "facebook" ? (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.5V4.4c-.3 0-1.2-.1-2.2-.1-2.2 0-3.8 1.4-3.8 3.9v2.3H8v3h2.5V21h3Z" />
  </svg>
) : name === "instagram" ? (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
    <rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".6" fill="currentColor" />
  </svg>
) : (
  <Lucide class={cls} size={size} stroke-width={1.9} aria-hidden="true" />
)}
